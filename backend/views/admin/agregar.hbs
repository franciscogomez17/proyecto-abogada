<div class="container" style="margin:100px auto;">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Agregar una nueva consulta</h4>
            <form action="/admin/consultas/agregar" method="post">
            <div class="mb-3 row">
                <input type="text" class="form-control" placeholder="Nombre" name="nombre">
            </div>
            <div class="mb-3 row">
                <input type="text" class="form-control" placeholder="Email" name="email">
            </div>
            <div class="mb-3 row">
                <input type="number" class="form-control" placeholder="Télefono" name="telefono">
            </div>
            <div class="mb-3 row">
                <input type="text" class="form-control" placeholder="Mótivo" name="motivo">
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            </form>
        </div>
    </div>
    {{#if error}}
    <h5>{{message}}</h5>
    {{/if}}
</div>