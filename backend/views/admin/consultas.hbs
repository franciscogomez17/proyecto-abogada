<div class="container" style="margin-top: 50px;">
    <div class="row">
        <p class="text-end">Hola! {{usuario}} <a class="btn btn-danger" href="/admin/login/logout">Cerrar Sesión <i class="fas fa-sign-out-alt"></i></a></p>
    </div>
</div>
<div class="container">
    <div class="text-end">
        <a href="/admin/consultas/agregar" class="btn btn-success">
            <i class="fas fa-plus"></i> Nuevo
        </a>
    </div>
<table class="table" style="table-striped">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Nombre</th>
      <th scope="col">Email</th>
      <th scope="col">Télefono</th>
      <th scope="col">Mótivo</th>
      <th scope="col" class="text-end">Acciones</th>
    </tr>
  </thead>
  <tbody>
    {{#each consultas}}
    <tr>
      <th scope="row">{{id}}</th>
      <td>{{nombre}}</td>
      <td>{{email}}</td>
      <td>{{telefono}}</td>
      <td>{{motivo}}</td>
         <td class="text-end">
                <a href="/admin/consultas/modificar/{{id}}" class="btn btn-sm btn-secondary">
                    <i class="fa fa-pencil-alt"></i>
                </a>
                <a href="/admin/consultas/eliminar/{{id}}" class="btn btn-sm btn-secondary">
                    <i class="fa fa-trash"></i>
                </a>
            </td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>