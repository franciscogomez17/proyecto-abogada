<div class="container" style="margin:50px auto">
    <div class="row">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <p>Hola <strong>{{ usuarios }}</strong>, bienvenido/a al panel de gestión.</p>
                <a class="btn btn-danger" href="/admin/login/logout">
                    Cerrar sesión <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
            <hr />
            
            <div class="row mt-5">
                <div class="col-7">
                    <h3>Listado de Consultas</h3>
                </div>
                <div class="col-5 text-end">
                    <a href="/admin/consultas/agregar" class="btn btn-success"><i class="fas fa-plus"></i> Nuevo</a>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col">
                    <table class="table table-striped">
                        <thead>
                            <tr class="table-dark">
                                <th scope="col">#</th>
                                <th scope="col">Nombre</th>
                                <th scope="col">Email</th>
                                <th scope="col">Motivo / Mensaje</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each consultas}}
                            <tr>
                                <th scope="row">{{id}}</th>
                                <td>{{nombre}}</td>
                                <td>{{email}}</td>
                                <td>{{motivo}}</td> 
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>